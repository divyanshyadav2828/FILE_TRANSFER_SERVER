<!DOCTYPE html>
<html lang="en" data-theme="<%= settings.theme || 'dark' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? `${title} - ${appName}` : appName %> | Local File Automation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="brand-logo">
          <div class="logo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
              <path d="m14 13 3 3m0 0-3 3m3-3H7"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-name">FILEFLOW</span>
            <span class="brand-tag">TRANSFER PRO</span>
          </div>
        </a>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section-title">MAIN</div>
        <a href="/" class="nav-item <%= currentPath === '/' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/jobs" class="nav-item <%= currentPath.startsWith('/jobs') ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
            <path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1Z"/>
            <path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>
          </svg>
          <span>Transfer Jobs</span>
        </a>

        <a href="/locations" class="nav-item <%= currentPath === '/locations' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Saved Locations</span>
        </a>

        <a href="/history" class="nav-item <%= currentPath.startsWith('/history') ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Execution History</span>
        </a>

        <div class="nav-section-title">SYSTEM</div>
        <a href="/settings" class="nav-item <%= currentPath === '/settings' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>Settings</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="server-status-pill">
          <span class="status-dot pulse"></span>
          <span class="status-text">127.0.0.1:3000</span>
        </div>
        <button id="themeToggleBtn" class="theme-toggle-btn" title="Toggle Theme">
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
      <!-- Topbar Header -->
      <header class="topbar">
        <div class="topbar-left">
          <div class="page-title-group">
            <h1 class="page-title"><%= title || 'Dashboard' %></h1>
          </div>
        </div>

        <div class="topbar-right">
          <% if (hasActiveRuns) { %>
            <a href="/execution" class="running-indicator-badge" id="globalRunningBadge">
              <span class="spinner-sm"></span>
              <span><%= activeRunsCount %> Active Job<%= activeRunsCount > 1 ? 's' : '' %> Running</span>
            </a>
          <% } %>

          <a href="/jobs/create" class="btn btn-primary btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>New Transfer Job</span>
          </a>
        </div>
      </header>

      <!-- Main Page Body -->
      <main class="page-content">
        <%- body %>
      </main>
    </div>
  </div>

  <!-- Global Toast Notification Container -->
  <div id="toastContainer" class="toast-container"></div>

  <!-- Reusable Windows Folder Explorer Modal -->
  <div id="folderExplorerModal" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-title-group">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
            <h3>Select Windows Folder</h3>
          </div>
          <button type="button" class="btn-close" onclick="closeFolderExplorer()">×</button>
        </div>

        <div class="modal-body">
          <!-- Drive Selector & Breadcrumbs -->
          <div class="explorer-drives-bar" id="explorerDrivesBar">
            <!-- Drives populated dynamically -->
          </div>

          <div class="explorer-path-bar">
            <button type="button" class="btn btn-secondary btn-icon-only" id="explorerUpBtn" title="Go up one folder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <input type="text" id="explorerCurrentPathInput" class="form-control mono-font" placeholder="C:\..." />
            <button type="button" class="btn btn-secondary" id="explorerGoBtn">Go</button>
            <button type="button" class="btn btn-secondary" id="explorerNewFolderBtn" title="Create new subfolder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2Z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
              <span>New Folder</span>
            </button>
          </div>

          <!-- Directory Items View -->
          <div class="explorer-items-container" id="explorerItemsList">
            <div class="explorer-loading">
              <span class="spinner"></span>
              <span>Scanning directories...</span>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <div class="explorer-selected-preview">
            <span class="text-muted">Selected:</span>
            <strong id="explorerSelectedDisplay" class="mono-font text-truncate">-</strong>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeFolderExplorer()">Cancel</button>
            <button type="button" class="btn btn-primary" id="explorerSelectConfirmBtn">Select This Folder</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- General Confirmation Modal -->
  <div id="confirmModal" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h3 id="confirmModalTitle">Confirm Action</h3>
          <button type="button" class="btn-close" onclick="closeConfirmModal()">×</button>
        </div>
        <div class="modal-body" id="confirmModalMessage">
          Are you sure?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
          <button type="button" class="btn btn-danger" id="confirmModalActionBtn">Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/folderPicker.js"></script>
</body>
</html>

<%- include('../partials/header') %>

<div class="form-page-container">
  <form id="jobForm" class="job-form" data-is-edit="<%= isEdit ? 'true' : 'false' %>" data-job-id="<%= job ? job.id : '' %>">
    <div class="card mb-4">
      <div class="card-header">
        <div class="card-header-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
          <h2><%= isEdit ? 'Edit Transfer Job' : 'Create Transfer Job' %></h2>
        </div>
      </div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group col-8">
            <label for="jobName" class="form-label required">Job Name</label>
            <input type="text" id="jobName" name="name" class="form-control" placeholder="e.g. Daily Project Backup, Server Archive" value="<%= job ? job.name : '' %>" required autofocus />
          </div>

          <div class="form-group col-4">
            <label for="conflictResolution" class="form-label">Conflict Resolution</label>
            <select id="conflictResolution" name="conflictResolution" class="form-control">
              <option value="replace_if_newer" <%= (job && job.conflictResolution === 'replace_if_newer') ? 'selected' : '' %>>Replace if Source is Newer (Recommended)</option>
              <option value="replace" <%= (job && job.conflictResolution === 'replace') ? 'selected' : '' %>>Always Overwrite / Replace</option>
              <option value="skip" <%= (job && job.conflictResolution === 'skip') ? 'selected' : '' %>>Skip Existing Files</option>
            </select>
          </div>
        </div>

        <div class="form-group mb-0">
          <label for="jobDescription" class="form-label">Description (Optional)</label>
          <input type="text" id="jobDescription" name="description" class="form-control" placeholder="Brief note about the purpose of this transfer job" value="<%= job ? job.description : '' %>" />
        </div>
      </div>
    </div>

    <!-- Multi-Step Transfer Operations Container -->
    <div class="steps-section-header">
      <div class="section-title">
        <h3>Transfer Steps</h3>
        <p class="text-muted text-sm">Define sequential file transfer operations between sources and destinations.</p>
      </div>
      <button type="button" class="btn btn-secondary btn-sm" id="addStepBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Transfer Step</span>
      </button>
    </div>

    <div id="stepsContainer" class="steps-container">
      <!-- Steps rendered here dynamically -->
    </div>

    <!-- Form Actions Bar -->
    <div class="form-actions-card card">
      <div class="form-actions-left">
        <button type="button" class="btn btn-secondary" id="formDryRunBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>Dry Run Test</span>
        </button>
      </div>
      <div class="form-actions-right">
        <a href="/jobs" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary" id="saveJobSubmitBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span><%= isEdit ? 'Update Job' : 'Save Job' %></span>
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Saved Locations Data for client JS -->
<script>
  window.INITIAL_SAVED_LOCATIONS = <%- JSON.stringify(locations || []) %>;
  window.INITIAL_JOB_DATA = <%- JSON.stringify(job || null) %>;
</script>
<script src="/js/jobForm.js"></script>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="job-details-page">
  <!-- Top Banner Card -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="job-details-header">
        <div class="job-details-title-area">
          <div class="job-badge-line">
            <span class="badge badge-primary"><%= job.steps.length %> Transfer Step<%= job.steps.length > 1 ? 's' : '' %></span>
            <span class="badge badge-outline">Conflict: <%= job.conflictResolution || 'replace_if_newer' %></span>
            <% if (isRunning) { %>
              <span class="badge badge-warning pulse">RUNNING</span>
            <% } %>
          </div>
          <h2 class="job-main-title"><%= job.name %></h2>
          <% if (job.description) { %>
            <p class="job-main-desc text-muted"><%= job.description %></p>
          <% } %>
        </div>

        <div class="job-details-actions">
          <button type="button" class="btn btn-primary btn-run-job" data-job-id="<%= job.id %>" data-job-name="<%= job.name %>">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>Run Job Now</span>
          </button>
          <button type="button" class="btn btn-secondary btn-dry-run-job" data-job-id="<%= job.id %>" data-job-name="<%= job.name %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Dry Run</span>
          </button>
          <a href="/jobs/<%= job.id %>/edit" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
            <span>Edit</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid-2-col">
    <!-- Steps Breakdown Column -->
    <div class="steps-column">
      <div class="card">
        <div class="card-header">
          <div class="card-header-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <h3>Configured Transfer Steps</h3>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="steps-detail-list">
            <% job.steps.forEach((step, idx) => { %>
              <div class="step-detail-card">
                <div class="step-detail-header">
                  <span class="step-number-badge">Step <%= idx + 1 %> of <%= job.steps.length %></span>
                  <span class="badge badge-<%= step.operation === 'move' ? 'warning' : 'primary' %>">
                    <%= step.operation ? step.operation.toUpperCase() : 'COPY' %>
                  </span>
                </div>

                <div class="step-flow-visual">
                  <div class="flow-endpoint">
                    <span class="endpoint-label">SOURCE</span>
                    <span class="endpoint-path mono-font" title="<%= step.source %>"><%= step.source %></span>
                  </div>
                  <div class="flow-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                  </div>
                  <div class="flow-endpoint">
                    <span class="endpoint-label">DESTINATION</span>
                    <span class="endpoint-path mono-font" title="<%= step.destination %>"><%= step.destination %></span>
                  </div>
                </div>

                <% if (step.exclude && step.exclude.length > 0) { %>
                  <div class="step-exclusions-detail">
                    <span class="text-xs text-muted font-semibold">EXCLUSIONS:</span>
                    <div class="exclusion-chips-list">
                      <% step.exclude.forEach(rule => { %>
                        <span class="badge badge-subtle mono-font"><%= rule %></span>
                      <% }) %>
                    </div>
                  </div>
                <% } else { %>
                  <div class="step-exclusions-detail">
                    <span class="text-xs text-muted">No exclusions configured for this step (all files included).</span>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Execution History Column -->
    <div class="history-column">
      <div class="card">
        <div class="card-header">
          <div class="card-header-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h3>Execution History</h3>
          </div>
        </div>

        <div class="card-body p-0">
          <% if (history.length === 0) { %>
            <div class="empty-state-sm">
              <p class="text-muted">This job has not been executed yet.</p>
              <button type="button" class="btn btn-primary btn-sm btn-run-job" data-job-id="<%= job.id %>" data-job-name="<%= job.name %>">Run Now</button>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Processed</th>
                    <th>Data</th>
                    <th class="text-right">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% history.forEach(run => { %>
                    <tr>
                      <td>
                        <span class="text-sm"><%= fileUtils.formatDate(run.startedAt) %></span>
                        <% if (run.isDryRun) { %><span class="badge badge-info badge-xs">DRY RUN</span><% } %>
                      </td>
                      <td>
                        <span class="badge badge-<%= run.status === 'success' ? 'success' : (run.status === 'partial' ? 'warning' : 'danger') %>">
                          <%= run.status.toUpperCase() %>
                        </span>
                      </td>
                      <td class="text-sm"><%= run.stats.copied %> / <%= run.stats.processed %></td>
                      <td class="text-sm mono-font"><%= fileUtils.formatBytes(run.stats.bytes) %></td>
                      <td class="text-right">
                        <a href="/execution/<%= run.id %>" class="btn btn-ghost btn-sm">View</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/dashboard.js"></script>
<%- include('../partials/footer') %>
